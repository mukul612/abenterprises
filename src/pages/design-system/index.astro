---
/**
 * Design system reference — renders every token and the Heat Scale in all four
 * modes and all three variants, so the system can be reviewed on its own before
 * pages are built on it. noindex, and excluded from the sitemap in astro.config.
 */
import Shell from '@layouts/Shell.astro';
import HeatScale from '@components/HeatScale.astro';
import { SCALES, valueToPercent } from '@lib/scales';

const steels = [950, 900, 800, 700, 600, 500, 400, 300, 200, 100];
const coppers = [700, 600, 500, 400, 300, 100];
const heats = [550, 700, 800, 900, 1000, 1100, 1250];
const lights = [
  ['zinc-50', '#EEF1F3', 'light section ground'],
  ['zinc-25', '#F7F9FA', ''],
  ['paper', '#FFFFFF', ''],
  ['rule', '#D3DBDF', 'hairline on light'],
];
const divisions = [
  ['cherry', 'Induction', 'incandescence'],
  ['nickel', 'Rectifiers', 'electroplating DC'],
  ['beam', 'Laser', 'fibre beam violet'],
];
const typeScale = [
  ['t-hero', '--t-hero', 'clamp(2.75rem, 6vw, 5rem) / 0.98', 'Archivo 700, wdth 112', 'Homepage H1 only'],
  ['t-h1', '--t-h1', 'clamp(2.125rem, 4vw, 3.25rem) / 1.06', 'Archivo 700, wdth 108', 'Page H1'],
  ['t-h2', '--t-h2', 'clamp(1.625rem, 2.6vw, 2.25rem) / 1.15', 'Archivo 600', 'Section heads'],
  ['t-h3', '--t-h3', '1.3125rem / 1.3', 'Plex Sans 600', 'Sub-heads'],
  ['t-body-lg', '--t-body-lg', '1.1875rem / 1.65', 'Plex Sans 400', 'Intro paragraphs'],
  ['t-body', '--t-body', '1.0625rem / 1.7', 'Plex Sans 400', 'Body'],
  ['t-small', '--t-small', '0.9375rem / 1.6', 'Plex Sans 400', 'Captions'],
  ['t-data', '--t-data', '0.9375rem / 1.45', 'Plex Mono 400, tnum', 'Spec tables, figures'],
  ['t-eyebrow', '--t-eyebrow', '0.75rem / 1.2', 'Plex Mono 500, 0.14em', 'Labels, model codes'],
];

/* Proves the tick/marker mapping agrees with the gradient */
const drift = SCALES.heat.ticks.map((t) => ({
  t,
  stops: valueToPercent('heat', t).percent,
  linear: ((t - 550) / 700) * 100,
}));
---

<Shell
  title="Design system — AB Induction"
  description="Token reference and Heat Scale component states."
  noindex
>
  <HeatScale mode="progress" />

  <main id="main">
    <!-- ── Header ─────────────────────────────────────────────────────── -->
    <header class="ground-deep grid-texture ds-hero">
      <div class="container">
        <p class="t-eyebrow ds-hero__eyebrow">AB Induction · Design system · Phase 1</p>
        <h1 class="t-hero">Cold electricity in, incandescent metal out</h1>
        <p class="t-body-lg measure ds-hero__sub">
          Cold ground, heat used as data. Every token below is the single source of
          truth in <code>src/styles/tokens.css</code>, wired into the Tailwind theme.
        </p>
      </div>
    </header>

    <!-- The full-width rule beneath the hero, §1.1 -->
    <HeatScale mode="rule" />

    <!-- ── 1. The Heat Scale ──────────────────────────────────────────── -->
    <section class="ground-dark grid-texture ds-section">
      <div class="container">
        <p class="t-eyebrow ds-kicker">§1 · Signature element</p>
        <h2 class="t-h2">The Heat Scale</h2>
        <p class="t-body measure ds-lede">
          A strip reproducing the real incandescence colours of steel, 550 °C faint
          red to 1250 °C white. Four modes, each informational rather than
          decorative. Ships zero JavaScript.
        </p>

        <div class="ds-modes">
          <div class="ds-mode">
            <p class="t-eyebrow">Mode 1 · Hero rule</p>
            <p class="t-small ds-note">
              Edge to edge beneath the hero. Fills 0→100 % over 900 ms on first
              paint, once, never loops. Shown at the top of this page.
            </p>
            <HeatScale mode="rule" />
          </div>

          <div class="ds-mode">
            <p class="t-eyebrow">Mode 2 · Scroll progress</p>
            <p class="t-small ds-note">
              Fixed to the top of the viewport, filling as you read — you are
              literally heating the page. Scroll to see it. CSS scroll-driven
              animation, no JS.
            </p>
          </div>

          <div class="ds-mode">
            <p class="t-eyebrow">Mode 4 · Section divider</p>
            <p class="t-small ds-note">2 px at 30 % opacity, on dark grounds only.</p>
            <HeatScale mode="divider" />
          </div>
        </div>
      </div>
    </section>

    <HeatScale mode="divider" />

    <!-- ── Mode 3: instrument ─────────────────────────────────────────── -->
    <section class="ground-dark ds-section">
      <div class="container">
        <p class="t-eyebrow ds-kicker">§1.3 · Mode 3</p>
        <h2 class="t-h2">The labelled instrument</h2>
        <p class="t-body measure ds-lede">
          On every process and machine page, with a marker showing the operating
          window. A buyer reads the machine's window at a glance.
        </p>

        <div class="ds-instruments">
          <HeatScale
            mode="instrument"
            band={[850, 950]}
            label="Induction hardening"
            id="inst-hardening"
          />
          <HeatScale
            mode="instrument"
            band={[600, 800]}
            label="Induction brazing"
            id="inst-brazing"
          />
          <HeatScale
            mode="instrument"
            band={[1150, 1250]}
            label="Induction forging"
            id="inst-forging"
          />
          <HeatScale
            mode="instrument"
            band={[200, 400]}
            label="Induction tempering"
            id="inst-tempering"
          />
        </div>

        <div class="ds-callout">
          <p class="t-eyebrow ds-callout__flag">Needs a decision</p>
          <p class="t-body">
            Tempering is one of the four example bands §1 gives, but at 200–400 °C
            it sits <em>below</em> the 550 °C floor of a scale defined by visible
            incandescence. Soldering, bonding, shrink fitting and preheating are
            sub-incandescent too — that is five of the nineteen process pages. The
            instrument currently refuses to fake a reading it cannot make. See the
            build notes for the proposed fix.
          </p>
        </div>
      </div>
    </section>

    <!-- ── Variants ───────────────────────────────────────────────────── -->
    <section class="ground-dark grid-texture ds-section">
      <div class="container">
        <p class="t-eyebrow ds-kicker">§1 · Same instrument, three physics</p>
        <h2 class="t-h2">Current and power scales</h2>

        <div class="ds-instruments">
          <HeatScale
            variant="current"
            mode="instrument"
            value={2000}
            label="Rectifier · 12 V 2000 A"
            id="inst-rect"
          />
          <HeatScale
            variant="current"
            mode="instrument"
            band={[300, 3000]}
            label="Rectifier range · air-cooled"
            id="inst-rect-range"
          />
          <HeatScale
            variant="power"
            mode="instrument"
            value={1500}
            label="Handheld laser welder · 1500 W"
            id="inst-laser"
          />
          <HeatScale
            variant="power"
            mode="instrument"
            band={[1000, 3000]}
            label="Handheld range"
            id="inst-laser-range"
          />
        </div>

        <div class="ds-table-wrap">
          <p class="t-eyebrow ds-kicker">Why marker positions are not linear</p>
          <table class="ds-table">
            <thead>
              <tr>
                <th scope="col">Tick °C</th>
                <th scope="col">Via gradient stops</th>
                <th scope="col">If linear</th>
                <th scope="col">Drift</th>
              </tr>
            </thead>
            <tbody>
              {
                drift.map((d) => (
                  <tr>
                    <td class="t-data">{d.t}</td>
                    <td class="t-data">{d.stops.toFixed(1)}%</td>
                    <td class="t-data">{d.linear.toFixed(1)}%</td>
                    <td class="t-data ds-drift">
                      {(d.stops - d.linear >= 0 ? '+' : '') + (d.stops - d.linear).toFixed(1)}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          <p class="t-small ds-note measure">
            The design system's gradient stops are evenly spaced per stop, not
            linear in temperature. Ticks and markers are interpolated through
            those same stops, so the colour under a marker is honest to the
            temperature it claims.
          </p>
        </div>
      </div>
    </section>

    <HeatScale mode="divider" />

    <!-- ── 2. Colour ──────────────────────────────────────────────────── -->
    <section class="ground-dark ds-section">
      <div class="container">
        <p class="t-eyebrow ds-kicker">§2</p>
        <h2 class="t-h2">Colour</h2>

        <h3 class="t-h3 ds-h3">Ground — cold-rolled steel</h3>
        <ul class="ds-swatches">
          {
            steels.map((s) => (
              <li class="ds-swatch">
                <span class="ds-swatch__chip" style={`background:var(--color-steel-${s})`} />
                <span class="t-data ds-swatch__name">steel-{s}</span>
              </li>
            ))
          }
        </ul>

        <h3 class="t-h3 ds-h3">Brand constant — inductor copper</h3>
        <ul class="ds-swatches">
          {
            coppers.map((c) => (
              <li class="ds-swatch">
                <span class="ds-swatch__chip" style={`background:var(--color-copper-${c})`} />
                <span class="t-data ds-swatch__name">copper-{c}</span>
              </li>
            ))
          }
        </ul>

        <h3 class="t-h3 ds-h3">Light surfaces — zinc, not cream</h3>
        <ul class="ds-swatches">
          {
            lights.map(([name, hex, use]) => (
              <li class="ds-swatch">
                <span class="ds-swatch__chip" style={`background:${hex}`} />
                <span class="t-data ds-swatch__name">{name}</span>
                {use && <span class="t-small ds-swatch__use">{use}</span>}
              </li>
            ))
          }
        </ul>

        <h3 class="t-h3 ds-h3">Division accents</h3>
        <p class="t-small ds-note measure">
          Never button colours. They tell you where you are, not what to click.
        </p>
        <div class="ds-divisions">
          {
            divisions.map(([key, name, note]) => (
              <div class="ds-division" style={`--accent:var(--color-${key}-500)`}>
                <p class="t-eyebrow ds-division__eyebrow">{name}</p>
                <p class="t-small ds-note">{note}</p>
                <div class="ds-division__swatches">
                  <span class="ds-chip" style={`background:var(--color-${key}-500)`}>
                    <span class="t-data">{key}-500</span>
                  </span>
                  <span class="ds-chip" style={`background:var(--color-${key}-700)`}>
                    <span class="t-data">{key}-700</span>
                  </span>
                </div>
              </div>
            ))
          }
        </div>

        <h3 class="t-h3 ds-h3">Heat scale — instrument only</h3>
        <p class="t-small ds-note measure">
          These never appear as UI colours. That restraint is what keeps the
          instrument meaningful.
        </p>
        <ul class="ds-swatches">
          {
            heats.map((h) => (
              <li class="ds-swatch">
                <span class="ds-swatch__chip" style={`background:var(--color-heat-${h})`} />
                <span class="t-data ds-swatch__name">heat-{h}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ── 3. Typography ──────────────────────────────────────────────── -->
    <section class="ground-light ds-section">
      <div class="container">
        <p class="t-eyebrow ds-kicker ds-kicker--light">§3</p>
        <h2 class="t-h2">Typography</h2>
        <p class="t-body measure ds-lede">
          Three roles, two families. A wide engineered grotesque against a humanist
          technical sans, with a mono for every number on the site.
        </p>

        <div class="ds-specimens">
          <p class="t-hero">Hardens an axle shaft in 42 seconds</p>
          <p class="t-h1">Vertical induction hardening machine</p>
          <p class="t-h2">Why induction beats case carburising</p>
          <p class="t-h3">Typical parts handled</p>
          <p class="t-body-lg measure">
            50 kW, 10–30 kHz, 100 % duty cycle. We design and manufacture induction
            heating, hardening and heat-treatment machines in Faridabad.
          </p>
          <p class="t-body measure">
            IBM Plex Sans was designed for engineering documentation, which is
            exactly what this site is. Measure is held at 68–74 characters so a
            plant engineer reading a process page never loses their line.
          </p>
          <p class="t-data">50 kW · 10–30 kHz · 415 V · 100 % · 850–950 °C · ABE-50AB</p>
          <p class="t-eyebrow">Model ABE-50AB · Induction · 850–950 °C</p>
        </div>

        <div class="ds-table-wrap">
          <table class="ds-table ds-table--light">
            <thead>
              <tr>
                <th scope="col">Class</th>
                <th scope="col">Token</th>
                <th scope="col">Size / line-height</th>
                <th scope="col">Face</th>
                <th scope="col">Use</th>
              </tr>
            </thead>
            <tbody>
              {
                typeScale.map(([cls, token, size, face, use]) => (
                  <tr>
                    <td class="t-data">.{cls}</td>
                    <td class="t-data">{token}</td>
                    <td class="t-data">{size}</td>
                    <td>{face}</td>
                    <td>{use}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <p class="t-small ds-note measure">
          Archivo is instanced to wght 600–700 × wdth 100–112 — exactly the three
          display settings above — taking the preloaded face from 88 kB to 34.6 kB
          with both axes still continuous.
        </p>
      </div>
    </section>

    <!-- ── Buttons & focus ────────────────────────────────────────────── -->
    <section class="ground-dark grid-texture ds-section">
      <div class="container">
        <p class="t-eyebrow ds-kicker">§6</p>
        <h2 class="t-h2">Buttons and focus</h2>
        <p class="t-body measure ds-lede">
          Copper is the only CTA colour across all three divisions. Buttons say what
          happens — never <em>Submit</em>, never <em>Learn more</em>. Tab through
          these to see the focus ring.
        </p>

        <div class="ds-buttons">
          <button type="button" class="btn btn--primary">Get a quote</button>
          <button type="button" class="btn btn--secondary">Send us your part</button>
          <a class="btn btn--tertiary" href="#main">Download the datasheet</a>
        </div>

        <p class="t-small ds-note">
          Hover the primary button: it moves to copper-400, not copper-600. Darkening
          the fill under a steel-950 label drops it to 3.93:1 — see the build notes.
        </p>
      </div>
    </section>

    <section class="ground-light ds-section">
      <div class="container">
        <h3 class="t-h3">The same controls on a light ground</h3>
        <p class="t-small ds-note measure">
          The focus ring switches to copper-700 here. copper-300 measures 1.77:1 on
          zinc-50, and SC 1.4.11 makes 3:1 mandatory for focus indicators.
        </p>
        <div class="ds-buttons">
          <button type="button" class="btn btn--primary">Get a quote</button>
          <button type="button" class="btn btn--secondary btn--on-light">
            Send us your part
          </button>
          <a class="btn btn--tertiary btn--on-light" href="#main">Download the datasheet</a>
        </div>
      </div>
    </section>

    <footer class="ground-deep ds-footer">
      <HeatScale mode="divider" />
      <div class="container">
        <p class="t-eyebrow">
          Phase 1 · Tokens, fonts and the Heat Scale · Layout and pages not yet built
        </p>
      </div>
    </footer>
  </main>
</Shell>

<style>
  .ds-hero {
    padding-block: clamp(48px, 10vw, 96px);
  }
  .ds-hero__eyebrow {
    color: var(--color-copper-400);
    margin-block-end: 20px;
  }
  .ds-hero__sub {
    color: var(--color-steel-300);
    margin-block-start: 24px;
  }
  .ds-hero__sub code {
    font-size: 0.9em;
    color: var(--color-steel-100);
  }

  .ds-section {
    padding-block: clamp(48px, 8vw, 96px);
  }
  .ds-kicker {
    color: var(--color-copper-400);
    margin-block-end: 12px;
  }
  .ds-kicker--light {
    color: var(--color-copper-700);
  }
  .ds-lede {
    color: var(--color-steel-300);
    margin-block-start: 16px;
  }
  .ground-light .ds-lede {
    color: var(--color-steel-600);
  }
  .ds-h3 {
    margin-block: 48px 16px;
  }
  .ds-note {
    color: var(--color-steel-400);
  }
  .ground-light .ds-note {
    color: var(--color-steel-600);
  }

  /* Heat Scale mode gallery */
  .ds-modes {
    display: grid;
    gap: 32px;
    margin-block-start: 40px;
  }
  @media (min-width: 720px) {
    .ds-modes {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .ds-mode {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px;
    background: var(--color-steel-800);
    border: 1px solid var(--color-steel-700);
    border-radius: var(--radius-md);
  }
  .ds-mode .t-eyebrow {
    color: var(--color-steel-100);
  }

  .ds-instruments {
    display: grid;
    gap: 40px 48px;
    margin-block-start: 40px;
  }
  @media (min-width: 720px) {
    .ds-instruments {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .ds-callout {
    margin-block-start: 48px;
    padding: 24px;
    border: 1px solid var(--color-warn);
    border-radius: var(--radius-md);
    background: rgb(209 155 27 / 0.06);
    max-width: 68ch;
  }
  .ds-callout__flag {
    color: var(--color-warn);
    margin-block-end: 12px;
  }

  /* Swatches */
  .ds-swatches {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(132px, 1fr));
    gap: 12px;
    margin-block-start: 16px;
  }
  .ds-swatch {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .ds-swatch__chip {
    display: block;
    block-size: 64px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-steel-700);
  }
  .ground-light .ds-swatch__chip {
    border-color: var(--color-rule);
  }
  .ds-swatch__name {
    color: var(--color-steel-300);
  }
  .ds-swatch__use {
    color: var(--color-steel-500);
  }

  .ds-divisions {
    display: grid;
    gap: 20px;
    margin-block-start: 20px;
  }
  @media (min-width: 720px) {
    .ds-divisions {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .ds-division {
    padding: 20px;
    background: var(--color-steel-800);
    border: 1px solid var(--color-steel-700);
    border-radius: var(--radius-md);
    /* the division-colour rule, §6 */
    border-block-start: 3px solid var(--accent);
  }
  .ds-division__eyebrow {
    color: var(--accent);
  }
  .ds-division__swatches {
    display: flex;
    gap: 8px;
    margin-block-start: 16px;
  }
  .ds-chip {
    flex: 1;
    display: grid;
    place-items: center;
    block-size: 48px;
    border-radius: var(--radius-sm);
    color: var(--color-steel-950);
  }

  /* Specimens */
  .ds-specimens {
    display: flex;
    flex-direction: column;
    gap: 28px;
    margin-block-start: 40px;
  }

  /* Tables — zero radius. Machines aren't round. §4 */
  .ds-table-wrap {
    margin-block-start: 40px;
    overflow-x: auto;
  }
  .ds-table {
    width: 100%;
    min-width: 520px;
    border-radius: 0;
    text-align: left;
  }
  .ds-table th {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-steel-400);
    padding: 10px 16px 10px 0;
    border-block-end: 1px solid var(--color-steel-700);
  }
  .ds-table td {
    padding: 10px 16px 10px 0;
    border-block-end: 1px solid var(--color-steel-700);
    color: var(--color-steel-100);
    vertical-align: top;
  }
  .ds-table tbody tr:nth-child(odd) {
    background: rgb(255 255 255 / 0.02);
  }
  .ds-table--light th {
    color: var(--color-steel-600);
    border-color: var(--color-rule);
  }
  .ds-table--light td {
    color: var(--color-steel-900);
    border-color: var(--color-rule);
  }
  .ds-table--light tbody tr:nth-child(odd) {
    background: rgb(14 22 27 / 0.02);
  }
  .ds-drift {
    color: var(--color-copper-400);
  }

  /* Buttons §6 */
  .ds-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    margin-block-start: 32px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-body);
    line-height: 1.2;
    border: 1px solid transparent;
    cursor: pointer;
    text-decoration: none;
    transition:
      background-color var(--dur-fast) var(--ease-brand),
      border-color var(--dur-fast) var(--ease-brand);
  }
  .btn--primary {
    background: var(--color-copper-500);
    color: var(--color-steel-950);
  }
  /* [a11y] lightens rather than darkens — see tokens.css */
  .btn--primary:hover {
    background: var(--color-copper-400);
  }
  .btn--secondary {
    background: transparent;
    border-color: var(--color-steel-400);
    color: var(--color-steel-100);
  }
  .btn--secondary:hover {
    border-color: var(--color-steel-300);
  }
  .btn--tertiary {
    padding-inline: 0;
    background: none;
    color: var(--color-copper-400);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  .btn--on-light.btn--secondary {
    border-color: var(--color-steel-600);
    color: var(--color-steel-900);
  }
  .btn--on-light.btn--tertiary {
    color: var(--color-copper-700);
  }

  .ds-footer {
    padding-block-end: 48px;
  }
  .ds-footer .container {
    padding-block-start: 32px;
  }
  .ds-footer .t-eyebrow {
    color: var(--color-steel-400);
  }
</style>
